<template>
  <ag-grid-vue v-bind="gridBindRef" v-on="gridEvents" />
</template>

<script setup>
  // Library - Common
  import { ref, shallowRef, computed, onMounted, watch } from 'vue'
  import { useRoute } from 'vue-router'
  import { storeToRefs } from 'pinia'

  // Library - Utils
  import * as _ from 'lodash-es'
  import BigNumber from 'bignumber.js'
  import { v4 as uuidv4 } from 'uuid'

  // Store
  import { useAppAuthenticationStore } from '@/stores/app-authentication'
  import { useAppPermissionStore } from '@/stores/app-permission'
  import { useAppMenuStore } from '@/stores/app-menu'

  // Helpers
  import { ApiCommon } from '@/utils/axios/api-common'
  import { dataUtil as DU } from '@/utils/functions/data-utility'
  import { toast } from '@/composables/useToast'
  import global from '@/constants/enums/global'

  // Custom Component
  import NoPermissionArea from '@/components/editors/button/NoPermissionArea.vue'
  import NewBasicToolBar from '@/components/toolBar/NewBasicToolBar.vue'
  import AggridLoadingOverlay from '@/components/aggrid/AgGridLoadingOverlay.vue'
  import AgDetailStatusBar from '@/components/aggrid/AgDetailStatusBar.vue'
  import AgCustomFilter from '@/components/aggrid/AgCustomFilter.vue'
  import AgComboEditor from '@/components/aggrid/AgComboEditor.vue'

  // GLOBAL
  const route = useRoute()
  const { userInfo } = storeToRefs(useAppAuthenticationStore())
  const { isSetupAdmin, projectPermissions } = storeToRefs(useAppPermissionStore())
  const { currentProjNo, currentEpId } = storeToRefs(useAppMenuStore())

  const _Emits = defineEmits(['show-overlay', 'hide-overlay', 'on-main-save-data'])
  const _Props = defineProps({
    // UTILS
    IS_CONVERT_BY_UOM_FACTOR_LNK: { type: Boolean, required: false, default: false },
    IS_CONVERT_BY_UOM_FACTOR_MAP: { type: Boolean, required: false, default: false },
    // PRE_LOAD_DATA
    PROJ_LIST: { type: [Array, Object], required: false, default: () => [] },
    PROJ_DICT: { type: Object, required: false, default: () => ({}) },
    REG_LIST: { type: [Array, Object], required: false, default: () => [] },
    REG_DICT: { type: Object, required: false, default: () => ({}) },
    EP_LIST: { type: [Array, Object], required: false, default: () => [] },
    EP_DICT: { type: Object, required: false, default: () => ({}) },
    CLS_LIST: { type: [Array, Object], required: false, default: () => [] },
    CLS_DICT: { type: Object, required: false, default: () => ({}) },
    TAG_TYPE_LIST: { type: [Array, Object], required: false, default: () => [] },
    TAG_TYPE_DICT: { type: Object, required: false, default: () => ({}) },
    UOM_LIST: { type: [Array, Object], required: false, default: () => [] },
    UOM_TREE: { type: [Array, Object], required: false, default: () => [] },
    UOM_DICT: { type: Object, required: false, default: () => ({}) },
    ATT_DICT: { type: Object, required: false, default: () => ({}) },
    REL_LIST: { type: [Array, Object], required: false, default: () => [] },
    REL_DICT: { type: Object, required: false, default: () => ({}) },
    PBS_SYS_LIST: { type: [Array, Object], required: false, default: () => [] },
    PBS_SYS_DICT: { type: Object, required: false, default: () => ({}) },
    PBS_ASM_LIST: { type: [Array, Object], required: false, default: () => [] },
    PBS_ASM_DICT: { type: Object, required: false, default: () => ({}) },
    // MAIN_DATA
    MAIN_FOCUS_DATA: { type: Object, required: false, default: null },
    MAIN_ORG_FOCUS_DATA: { type: Object, required: false, default: null },
    IS_MANAGER_DATA: { type: [Boolean, Object], required: false, default: false },
  })

  // UTILS
  const isConvertByUomFactorLnkRef = computed(() => _Props.IS_CONVERT_BY_UOM_FACTOR_LNK) // DEF_VAL, MIN_VAL, MAX_VAL
  const isConvertByUomFactorMapRef = computed(() => _Props.IS_CONVERT_BY_UOM_FACTOR_MAP) // OPER-VALUE
  // PRE_LOAD_DATA
  const projListRef = computed(() => _Props.PROJ_LIST)
  const projDictRef = computed(() => _Props.PROJ_DICT)
  const regListRef = computed(() => _Props.REG_LIST)
  const regDictRef = computed(() => _Props.REG_DICT)
  const epListRef = computed(() => _Props.EP_LIST)
  const epDictRef = computed(() => _Props.EP_DICT)
  const clsListRef = computed(() => _Props.CLS_LIST)
  const clsDictRef = computed(() => _Props.CLS_DICT)
  const tagTypeListRef = computed(() => _Props.TAG_TYPE_LIST)
  const tagTypeDictRef = computed(() => _Props.TAG_TYPE_DICT)
  const uomListRef = computed(() => _Props.UOM_LIST)
  const uomTreeRef = computed(() => _Props.UOM_TREE)
  const uomDictRef = computed(() => _Props.UOM_DICT)
  const attDictRef = computed(() => _Props.ATT_DICT)
  const pbsSysListRef = computed(() => _Props.PBS_SYS_LIST)
  const pbsSysDictRef = computed(() => _Props.PBS_SYS_DICT)
  const pbsAsmListRef = computed(() => _Props.PBS_ASM_LIST)
  const pbsAsmDictRef = computed(() => _Props.PBS_ASM_DICT)
  // MAIN_DATA
  const mainFocusDataRef = computed(() => _Props.MAIN_FOCUS_DATA)
  const mainOrgFocusDataRef = computed(() => _Props.MAIN_ORG_FOCUS_DATA)
  const mainIsManagerDataRef = computed(() => _Props.IS_MANAGER_DATA)
  watch(mainOrgFocusDataRef, item => {
    onInitializeDebounce()
  })

  // prettier-ignore
  const firstFocusIDRef = computed(() => {
    const [hashPath = '', hashQuery = ''] = (route.hash ?? '').split('?')
    const hashParam = new URLSearchParams(hashQuery)
    if (hashPath === '#linked') { return hashParam.get('reg_type_id'); }
    return null
  })

  // prettier-ignore
  const pageLabelRef = computed(() => {
    const { TYPE_ID: cName, DESC: cDesc } = mainFocusDataRef.value ?? {}
    const { TYPE_ID: oName, DESC: oDesc } = mainOrgFocusDataRef.value ?? {}
    if (!oName) { return ''; }
    const txtCDesc = cDesc ?? ''
    const txtCName = cName ? ` ( ${cName} )` : ''
    const txtCLabel = !cDesc && !cName ? '' : `${txtCDesc}${txtCName}`
    const txtODesc = oDesc ?? ''
    const txtOName = oName ? ` ( ${oName} )` : ''
    const txtOLabel = !oDesc && !oName ? '' : `${txtODesc}${txtOName}`
    return oName && oName !== cName ? `${txtCLabel} <= ${txtOLabel}` : `${txtCLabel}`
  })
  const gridContextRef = computed(() => {
    // const { TYPE_ID: tagTypeId } = mainOrgFocusDataRef.value ?? {}
    // const txtKey = tagTypeId ? 'TYPE ID : ' : ''
    // const txtVal = tagTypeId || ''
    // return { customKey: txtKey, customValue: txtVal }
    return { customKey: 'Register Info : ', customValue: pageLabelRef.value }
  })
  const onShowOverlay = config => _Emits('show-overlay', config)
  const onHideOverlay = () => _Emits('hide-overlay')
  const onShowLoading = () => gridRef.value?.setGridOption('loading', true)
  const onHideLoading = () => gridRef.value?.setGridOption('loading', false)

  // TOOLBAR BUTTON
  const isDisabledDeleteBtn = shallowRef(true)
  const toolbarBindRef = computed(() => ({
    showCreate: true,
    showMultiCreate: true,
    showDelete: true,
    // blockCreate: false,
    // blockDelete: false,
  }))
  const toolbarEventsRef = computed(() => ({
    execCreate: onCreateRows,
    execMultiCreate: onCreateMultiRows,
    execDelete: onDeleteRows,
  }))

  // Tab으로 사용시 action영역 설정
  const contentsActionRef = computed(() => {
    const { PROJ_NO: mainProjNo } = mainOrgFocusDataRef.value ?? {}
    if (!mainFocusDataRef.value) return '선택된 Register가 없습니다.'
    if (!mainOrgFocusDataRef.value) return 'Linked Register can be modified after save.'
    if (mainProjNo !== currentProjNo.value) return 'OOTB Register cannot be modified.'
    if (!mainIsManagerDataRef.value) return NoPermissionArea
    return NewBasicToolBar
  })
  const contentsActionPropsRef = computed(() => {
    if (!mainIsManagerDataRef.value) return null
    return !DU.isString(contentsActionRef.value) ? toolbarBindRef.value : { style: { color: 'var(--txt05)' } }
  })
  const contentsActionEventsRef = computed(() => {
    if (!mainIsManagerDataRef.value) return null
    return !DU.isString(contentsActionRef.value) ? toolbarEventsRef.value : null
  })

  // MODIFIED DATA
  const isEditedRef = ref(false)

  // FOCUS DATA
  const prevIndexRef = shallowRef(-1)
  const focusDataRef = ref(null)
  const focusDataOrgRef = computed(() => {
    const focusData = focusDataRef.value
    const rowId = focusData?._ROW_ID
    if (rowId) {
      const dataDict = gridDataOrgDictRef.value
      return dataDict?.[rowId]
    }
    return undefined
  })
  const focusRegDataRef = computed(() => regDictRef.value?.[focusDataRef.value?.TYPE_ID])
  const isManagerDataRef = computed(() => {
    const focusInfo = focusDataRef.value
    const focusData = regDictRef.value?.[focusInfo?.TYPE_ID]
    if (focusData && focusData.EP_ID && focusData.PROJ_NO && focusData.PROJ_NO === currentProjNo.value) {
      if (isSetupAdmin.value) return true
      if (projectPermissions.value?.some(v => v.EP_ID === focusData.EP_ID && v.Role === 'Manager')) return true
    }
    return false
  })

  // GRID
  const gridRef = shallowRef()
  const gridDataRef = ref([])
  const gridDelDataRef = shallowRef([]) // DELETED == true의 데이터
  // 데이터 원본 확인용
  const gridDataOrgRef = shallowRef([])
  const gridDataOrgDictRef = shallowRef({}) // 데이터 원본 확인용 { _ROW_ID: data, ... }
  const gridDataRenderedRef = shallowRef(false)
  const gridInitializingRef = shallowRef(false)
  const gridFrameIdRef = shallowRef(0) // requestAnimationFrame내 Grid RefreshCells용 token
  const gridRefreshCellsOptionRef = shallowRef(null) // requestAnimationFrame내 Grid RefreshCells용 Option
  const dateFilterParams = {
    minValidDate: '2008-01-08',
    maxValidDate: new Date(new Date().getTime() + 24 * 60 * 60 * 1000),
    comparator: (filterLocalDateAtMidnight, cellValue) => {
      const dateStr = cellValue?.substring(0, 10)
      if (!dateStr) {
        return -1
      }
      const splitted = dateStr.split('-')
      const date = new Date(Number(splitted[0]), Number(splitted[1]) - 1, Number(splitted[2]))

      if (filterLocalDateAtMidnight.getTime() === date.getTime()) {
        return 0
      } else if (filterLocalDateAtMidnight > date) {
        return -1
      } else if (filterLocalDateAtMidnight < date) {
        return 1
      }
      return 0
    },
  }
  // prettier-ignore
  const gridColDefsRef = ref([
    {
      suppressHeaderMenuButton: true,
      minWidth: 30,
      maxWidth: 30,
      pinned: 'left',
      lockPinned: true,
      lockVisible: true,
      lockPosition: 'left',
      suppressMovable: true,
      resizable: false,
      sortable: false,
      editable: false,
      filter: false,
      rowDrag: params => {
        return !params.node.group && mainOrgFocusDataRef.value?.PROJ_NO === currentProjNo.value
      },
    },
    {
      suppressHeaderMenuButton: true,
      headerCheckboxSelectionFilteredOnly: true,
      minWidth: 30,
      maxWidth: 30,
      pinned: 'left',
      lockPinned: true,
      lockVisible: true,
      lockPosition: 'left',
      suppressMovable: true,
      resizable: false,
      sortable: false,
      editable: false,
      filter: 'agSetColumnFilter',
      filterValueGetter: params => params.node.selected,
      filterParams: {
        suppressSorting: true,
        refreshValuesOnOpen: true,
      },
      checkboxSelection: params => {
        return !params.node.group && mainOrgFocusDataRef.value?.PROJ_NO === currentProjNo.value
      },
      headerCheckboxSelection: params => mainOrgFocusDataRef.value?.PROJ_NO === currentProjNo.value,
    },
    {
      field: '_STATUS',
      headerName: 'Status',
      hide: true,
      minWidth: 60,
      maxWidth: 60,
      pinned: 'left',
      lockPinned: true,
      // lockVisible: true,
      lockPosition: 'left',
      suppressMovable: true,
      resizable: false,
      cellClass: 'agReadOnly',
      editable: false,
      cellRenderer: params => {
        const value = params.value
        if (value) {
          const wrap = document.createElement('div')
          const badge = document.createElement('span')
          wrap.className = 'w-100 h-100 d-flex justify-content-center align-items-center'
          switch (value) {
            case 'A': {
              badge.className = `badge rounded-pill fs-12px bg-green-400 text-border-gray`
              badge.textContent = 'New'
            } break
            case 'M': {
              badge.className = `badge rounded-pill fs-12px bg-orange-400 text-border-gray`
              badge.textContent = 'Mod' // Modified
            } break
            case 'D': {
              badge.className = `badge rounded-pill fs-12px bg-red-400 text-border-gray`
              badge.textContent = 'Del' // Deleted
            } break
          }
          wrap.append(badge)
          return wrap
        }
      },
    },
    {
      field: 'TYPE_ID',
      headerName: 'Register ID',
      pinned: 'left',
      lockPinned: true,
      lockVisible: true,
      lockPosition: 'left',
      minWidth: 120,
      flex: 5,
      editable: params => {
        return mainIsManagerDataRef.value
      },
      cellStyle: params => {
        const value = params.value
        if (value) {
          const regInfo = regDictRef.value?.[value]
          if (!regInfo || regInfo?.DELETED) {
            return {
              color: '#ff0000',
              textDecoration: 'line-through',
            }
          }
        }
        return {
          // 초기화 없으면 스타일 유지됨
          color: '',
          textDecoration: '',
        }
      },
      cellRenderer: params => {
        const dataItem     = params.data
        const displayValue = params.valueFormatted || params.value || ''
        const editableDef  = params.colDef?.editable;
        const editable     = (
          DU.isFunction(editableDef) ? editableDef(params) : editableDef
        );
        const regInfo = regDictRef.value?.[dataItem?.TYPE_ID];
        const regTypeId = regInfo?.TYPE_ID;

        const queryParam = {};
        const projNo = dataItem?.PROJ_NO || currentProjNo.value;
        if (projNo) {
          queryParam.proj_no = projNo;
          if (currentEpId.value && projNo === currentProjNo.value) {
            queryParam.ep_id = currentEpId.value;
          }
          if (regTypeId) {
            queryParam.reg_type_id = regTypeId;
          }
        }
        return makeComboRender({
          value   : displayValue,
          editable: editable,
          linkUrl  : '/register-mapping-setup',
          linkParam: queryParam,
        });
      },
      singleClickEdit: false,
      cellEditorPopup: true,
      cellEditorPopupPosition: 'over',
      cellEditor: 'AgComboEditor', // 'agRichSelectCellEditor'
      cellEditorParams: params => {
        const grid = params.api
        const value = params.value
        const mainFocusData = mainFocusDataRef.value
        const mainEpId = mainFocusData?.EP_ID
        const values = []
        const existsList = []
        grid.forEachNode(node => {
          if (node.data?.TYPE_ID && node.data?.TYPE_ID !== value) {
            existsList.push(node.data?.TYPE_ID)
          }
        })
        regListRef.value?.forEach(v => {
          if (v.TYPE_ID && v.EP_ID === mainEpId && !existsList.includes(v.TYPE_ID)) {
            values.push(v.TYPE_ID)
          }
        })
        return {
          values            : values,
          searchType        : 'matchAny',
          highlightMatch    : true,
          valueListMaxHeight: 200,
          valueListMaxWidth : 200,
          // AgComboEditor Parameters
          placeholder         : 'Select Register', // Default = ''
          code                : 'ATT_ID',  // Default = 'code'
          label               : 'label', // Default = 'label'
          pushTags            : false,   // Default = false
          multiple            : false,   // Default = false
          multipleCheck       : false,   // Default = false
          treeSelect          : false,   // Default = false
          closeOnSelect       : false,   // Default = true
          deselectFromDropdown: false,   // Default = false
          returnOrigin        : false,   // Default = false
          applySelected       : true,    // Default = false
          // getOptionLabel      : (v) => (`${v.label} (${v.code})`),
        }
      },
    },
    {
      field: 'EP_ID',
      headerName: 'EP',
      width: 60,
      flex: 1,
      cellClass: 'agReadOnly',
      cellRenderer: params => {
        const dataItem     = params.data
        const regTypeId    = dataItem?.TYPE_ID
        const regInfo      = regDictRef.value?.[regTypeId];
        const { EP_ID, DESC, NEW_TAG_YN, REMARK, SEQ } = regInfo || {}
        return makeComboRender({
          value   : EP_ID,
          editable: false,
        });
      },
    },
    {
      field: 'DESC',
      headerName: 'Description',
      minWidth: 150,
      flex: 4,
      cellClass: 'agReadOnly',
      cellRenderer: params => {
        const dataItem     = params.data
        const regTypeId    = dataItem?.TYPE_ID
        const regInfo      = regDictRef.value?.[regTypeId];
        const { EP_ID, DESC, NEW_TAG_YN, REMARK, SEQ } = regInfo || {}
        return makeComboRender({
          value   : DESC,
          editable: false,
        });
      },
    },
    {
      field: 'NEW_TAG_YN',
      headerName: 'Object Create',
      cellDataType: 'boolean', // Use Using valueParser
      width: 60,
      // tooltipValueGetter: params => params.valueFormatted || params.value,
      filter: 'agSetColumnFilter',
      filterValueGetter: params => regDictRef.value?.[params.data?.TYPE_ID]?.NEW_TAG_YN,
      cellClass: 'agReadOnly',
      cellStyle: { justifyItems: 'center' },
      // cellEditor: 'agCheckboxCellEditor',
    },
    {
      field: 'USE_WRK_YN',
      headerName: 'Working',
      cellDataType: 'boolean', // Use Using valueParser
      width: 60,
      // tooltipValueGetter: params => params.valueFormatted || params.value,
      filter: 'agSetColumnFilter',
      filterValueGetter: params => regDictRef.value?.[params.data?.TYPE_ID]?.USE_WRK_YN,
      cellClass: 'agReadOnly',
      cellStyle: { justifyItems: 'center' },
      // cellEditor: 'agCheckboxCellEditor',
    },
    // 2602012 개발팀 요청으로 All Tag 사용하지 않아서 우선 숨김 처리.
    // {
    //   field: 'ALL_TAG_YN',
    //   headerName: 'All Tag',
    //   hide: true,
    //   width: 60,
    //   // tooltipValueGetter: params => params.valueFormatted || params.value,
    // },
    {
      field: 'REMARK',
      headerName: 'Remark',
      flex: 3,
      cellClass: 'agReadOnly',
      cellRenderer: params => {
        const dataItem     = params.data
        const regTypeId    = dataItem?.TYPE_ID
        const regInfo      = regDictRef.value?.[regTypeId];
        const { EP_ID, DESC, NEW_TAG_YN, REMARK, SEQ } = regInfo || {}
        return makeComboRender({
          value   : REMARK,
          editable: false,
        });
      },
    },
    {
      field: 'SEQ',
      headerName: 'SEQ',
      width: 70,
      cellDataType: 'number',
      cellClass: 'agReadOnly',
      hide: true,
      cellRenderer: params => {
        const dataItem     = params.data
        const regTypeId    = dataItem?.TYPE_ID
        const regInfo      = regDictRef.value?.[regTypeId];
        const { EP_ID, DESC, NEW_TAG_YN, REMARK, SEQ } = regInfo || {}
        return makeComboRender({
          value   : SEQ,
          editable: false,
        });
      },
    },
  ])

  // prettier-ignore
  const onInitialize = async function () {
    const onFinally = function () {
      // Execute after data-binding
      setTimeout(() => {
        if (gridDataRenderedRef.value) { setFocusData(); }
        onRefreshCells()
        onHideLoading()
        // onHideOverlay()
        gridDataRenderedRef.value = true
        setTimeout(() => (gridInitializingRef.value = false), 0)
      }, 10)
    }
    gridInitializingRef.value = true;

    // onShowOverlay()
    onShowLoading()
    onResetSelection()
    prevIndexRef.value = -1
    focusDataRef.value = null
    isEditedRef.value = false
    gridDataRef.value = []
    gridDataOrgRef.value = []
    gridDataOrgDictRef.value = {}

    const mainFocusData = mainFocusDataRef.value
    const mainOrgFocusData = mainOrgFocusDataRef.value
    if (!mainOrgFocusData || !mainFocusData) { return onFinally(); }

    if (!mainFocusData.CMPL_SETT) { mainFocusData.CMPL_SETT = {}; }
    const { REG_TYPE_IDS: regTypeIds } = mainFocusData.CMPL_SETT

    const cusValues = []
    const orgValues = []
    const orgValuesDict = {}
    regTypeIds?.forEach((item, index) => {
      const rowId = `VAL_${String(index).padStart(6, '0')}`
      const newTagYn = regDictRef.value?.[item]?.NEW_TAG_YN === true
      orgValuesDict[rowId] = { TYPE_ID: item, NEW_TAG_YN: newTagYn, _ROW_ID: rowId }
      orgValues.push(orgValuesDict[rowId])
      cusValues.push({ TYPE_ID: item, NEW_TAG_YN: newTagYn, _ROW_ID: rowId })
      
    })
    gridDataRef.value = cusValues
    gridDataOrgRef.value = orgValues
    gridDataOrgDictRef.value = orgValuesDict

    return onFinally()
  }
  const onInitializeDebounce = _.debounce(onInitialize, 100)

  const onCreateRows = function () {
    insertRows(1)
  }

  const onCreateMultiRows = function (rowCount) {
    insertRows(rowCount)
  }

  const insertRows = function (rowCount) {
    const mainOrgFocusData = mainOrgFocusDataRef.value
    if (!mainOrgFocusData) {
      toast.warning({ title: 'Select a row from the Tag Type list to add values.', duration: 5000 })
      return
    }

    const grid = gridRef.value
    grid.stopEditing()
    onShowLoading()

    let maxSeq = 0
    grid.forEachNode(node => {
      const seq = Number(node.data?.SEQ)
      if (!isNaN(seq) && seq > maxSeq) {
        maxSeq = seq
      }
    })

    const addRows = []
    for (let i = 0; i < rowCount; i++) {
      const newId = `NEW_VAL_${Math.random().toString(36).substring(2, 12)}`
      addRows.push({
        _ROW_ID: newId,
        _STATUS: 'A',

        TYPE_ID: null,
      })
    }
    if (addRows.length) {
      gridDataRef.value.push(...addRows)
      const lastIndex = grid.getDisplayedRowCount()
      const result = grid.applyTransaction({ add: addRows, addIndex: lastIndex })
      onRefreshCells()
      grid.setNodesSelected({
        nodes: result.add,
        newValue: true,
      })
      grid.ensureIndexVisible(lastIndex, 'bottom')
      isEditedRef.value = true
    }
    onHideLoading()
  }

  const onDeleteRows = function () {
    const grid = gridRef.value
    const selectedRows = grid?.getSelectedRows()
    if (!selectedRows || !selectedRows.length) {
      toast.warning({ title: `Please select the data you want to delete.`, duration: 5000 })
      return
    }
    gridDataRef.value = gridDataRef.value.filter(({ _ROW_ID }) => {
      return !selectedRows.some(v => v._ROW_ID === _ROW_ID)
    })
    gridDataOrgRef.value = gridDataOrgRef.value.filter(({ _ROW_ID }) => {
      return !selectedRows.some(v => v._ROW_ID === _ROW_ID)
    })

    isEditedRef.value = true
    setFocusData()
  }

  const setFocusData = function () {
    const grid = gridRef.value
    const selections = grid?.getCellRanges()
    let rowIndex = -1
    let rowData = null
    if (selections && selections.length) {
      rowIndex = selections[0]?.startRow?.rowIndex ?? -1
      rowData = grid?.getDisplayedRowAtIndex(rowIndex)?.data
    }
    prevIndexRef.value = rowIndex
    focusDataRef.value = rowData
  }

  // GRID /////////////////////////////////////////////////////////////////////
  /////////////////////////////////////////////////////////////////////////////
  const onStopEditing = function () {
    gridRef.value?.stopEditing()
  }

  const makeComboRender = function (PARAMS) {
    const { value, editable, linkUrl, linkParam, hideComboIcon, notice, noticeType } = PARAMS ?? {}
    const wrap = document.createElement('div')
    const span = document.createElement('span')
    const icon = document.createElement('i')
    const link = document.createElement(linkUrl && !DU.isArray(linkParam) ? 'a' : 'span')
    wrap.className = 'd-flex align-items-center w-100 h-100'
    span.className = 'flex-1 text-ellipsis'
    icon.className = editable && hideComboIcon !== false ? 'fa fa-xs fa-caret-down p-1 text-blue' : ''
    link.textContent = value
    if (linkUrl) {
      const path = linkUrl.startsWith('/') ? linkUrl.slice(1) : linkUrl
      link.href = 'javascript:void(0)'
      if (DU.isArray(linkParam)) {
        link.textContent = ''
        linkParam.forEach(v => {
          const { value: subValue, ...subParam } = v
          const subLink = document.createElement('a')
          subLink.href = 'javascript:void(0)'
          subLink.textContent = subValue
          subLink.onclick = () => {
            const args = new URLSearchParams(subParam)
            window.open(`${import.meta.env.BASE_URL}${path}?${args.toString()}`, '_blank', '')
          }
          link.append(subLink, ', ')
        })
        if (link.lastChild.nodeType == Node.TEXT_NODE) {
          link.lastChild.remove()
        }
      } else {
        link.onclick = () => {
          const args = new URLSearchParams(linkParam)
          window.open(`${import.meta.env.BASE_URL}${path}?${args.toString()}`, '_blank', '')
        }
      }
    }
    span.append(link)

    // prettier-ignore
    if (notice) {
      // const notiType = String(noticeType ?? '').toLowerCase()
      const notiType = 'warning'
      let iconClass = 'text-teal'
      let notiClass = 'text-white bg-teal'
      switch (notiType) {
        case 'warning': {
          iconClass = 'text-orange';
          notiClass = 'text-white bg-orange'
        } break;
        case 'error': {
          iconClass = 'text-red'
          notiClass = 'text-white bg-red'
        } break;
        case 'success': {
          iconClass = 'text-cyan'
          notiClass = 'text-white bg-cyan'
        } break;
        case 'info': {
          iconClass = 'text-blue'
          notiClass = 'text-white bg-blue'
        } break;
        case 'question': {
          iconClass = 'text-grey'
          notiClass = 'text-white bg-grey'
        } break;
      }
      const notiIcon = document.createElement('i')
      notiIcon.className = `fa fa-info-circle p-2 ps-0 fs-6 cursor-pointer ${iconClass}`
      notiIcon.onclick = e => {
        e.preventDefault()
        e.stopPropagation()

        const { top: notiIconTop, left: notiIconLeft, width: notiIconWidth } = notiIcon.getBoundingClientRect()
        const notiTop = window.scrollY + notiIconTop + 5
        const notiLeft = window.scrollX + notiIconLeft + notiIconWidth + 0

        const notiWrap = document.createElement('div')
        const noti = document.createElement('span')
        const notiClose = document.createElement('i')
        notiWrap.className = `ag-cell-notice-tooltip position-fixed d-flex`
        notiWrap.style.top = `${notiTop}px`
        notiWrap.style.left = `${notiLeft}px`
        notiWrap.onclick = ev => ev.stopPropagation()
        notiWrap.onmouseover = () => (notiClose.style.opacity = '1')
        notiWrap.onmouseleave = () => (notiClose.style.opacity = '0')
        noti.textContent = notice
        noti.className = `p-2 ${notiClass}`
        noti.style.cssText = `
          border-radius: 5px;
          line-height: normal;
          z-index: 1;
        `
        notiClose.className = `fa fa-close
          bg-gray-100 text-red text-center p-2px z-1
          position-absolute rounded-circle cursor-pointer
        `
        notiClose.style.cssText = `
          top: -9px;
          right: -7px;
          width: 18px;
          height: 18px;
          border: 1px solid #ff000050;
          opacity: 0;
          transition: opacity 0.2s ease
        `
        notiClose.onclick = () => notiWrap.remove()

        const notices = document.querySelectorAll('body > .ag-cell-notice-tooltip')
        if (notices.length) { notices.forEach(v => v.remove()) }
        window.addEventListener('click', () => notiWrap.remove(), { once: true })

        notiWrap.append(noti, notiClose)
        document.body.append(notiWrap)
      }
      wrap.append(notiIcon, span, icon)
      return wrap
    }

    wrap.append(span, icon)
    return wrap
  }

  const makeCellClass = function (params) {
    if (params.node.group) {
      return
    }
    const field = params.colDef?.field
    const value = params.value
    const rowIdField = '_ROW_ID'
    const orgData = gridDataOrgDictRef.value?.[params.data?.[rowIdField]]
    const orgValue = orgData?.[field]
    if (field) {
      if (orgData) {
        if (Array.isArray(orgValue)) {
          if (Array.isArray(value)) {
            if (orgValue.join(',') !== value.join(',')) {
              return 'hasWork'
            }
          } else {
            if (value) {
              return 'hasWork'
            } else {
              return 'hasWorkEmpty'
            }
          }
        } else {
          // Diff Value
          if (value != orgValue) {
            return !value ? 'hasWorkEmpty' : 'hasWork'
          }
        }
      } else {
        // New Rows
        return 'hasWorkEmpty'
      }
    }
    return
  }

  const onRefreshCells = function (option = { force: true, suppressFlash: true }) {
    const grid = gridRef.value
    const frameId = (gridFrameIdRef.value += 1)
    if (grid) {
      const {
        force: newForce,
        suppressFlash: newSuppressFlash,
        rowNodes: newRowNodes,
        columns: newColumns,
      } = Object.assign({}, option)
      if (!gridRefreshCellsOptionRef.value) {
        gridRefreshCellsOptionRef.value = {
          force: newForce,
          suppressFlash: newSuppressFlash,
          rowNodes: newRowNodes,
          columns: newColumns,
        }
      } else {
        const { force, suppressFlash, rowNodes, columns } = gridRefreshCellsOptionRef.value
        if (!force && newForce === true) {
          gridRefreshCellsOptionRef.value.force = true
        }
        if (!suppressFlash && newSuppressFlash === true) {
          gridRefreshCellsOptionRef.value.suppressFlash = true
        }
        if (rowNodes) {
          gridRefreshCellsOptionRef.value.rowNodes = !newRowNodes ? undefined : [...rowNodes, ...newRowNodes]
        }
        if (columns) {
          gridRefreshCellsOptionRef.value.columns = !newColumns ? undefined : [...columns, ...newColumns]
        }
      }
      requestAnimationFrame(() => {
        if (frameId === gridFrameIdRef.value) {
          requestAnimationFrame(() => {
            if (frameId === gridFrameIdRef.value) {
              grid.refreshCells(gridRefreshCellsOptionRef.value)
              gridRefreshCellsOptionRef.value = null
            }
          })
        }
      })
    }
  }

  const onResetSelection = function () {
    const grid = gridRef.value
    if (grid) {
      grid.stopEditing()
      grid.clearRangeSelection()
      grid.clearFocusedCell()
      grid.deselectAll()
      onRefreshCells()
    }
  }

  const onGetRowId = function (params) {
    return params.data?._ROW_ID
  }

  const onGridReady = function (params) {
    gridRef.value = params.api
    onInitialize()
  }

  const onFirstDataRendered = function (params) {
    const focusId = firstFocusIDRef.value
    if (focusId) {
      const grid = params.api
      grid.forEachNode(node => {
        if (node.data?.ATT_ID === focusId) {
          grid.setRowNodeExpanded(node, true, true, true)
          grid.ensureNodeVisible(node, 'middle')
          if (mainOrgFocusDataRef.value?.PROJ_NO === currentProjNo.value) {
            node.setSelected(true)
          }
          prevIndexRef.value = node.rowIndex
          focusDataRef.value = node.data
        }
      })
    }
  }

  const onCellFocused = async function (params) {
    const grid = params.api
    const rowIndex = params.rowIndex
    const prevIndex = prevIndexRef.value
    if (prevIndex !== rowIndex) {
      prevIndexRef.value = rowIndex
      focusDataRef.value = grid.getDisplayedRowAtIndex(rowIndex)?.data
    }
  }

  const onRowSelected = function (params) {
    const selectedRows = params.api.getSelectedRows()
    isDisabledDeleteBtn.value = !selectedRows.length
  }

  const onRowDragEnd = function (params) {
    isEditedRef.value = true
    onRefreshCells()
  }

  // prettier-ignore
  const onCellValueChanged = function (params) {
    const grid = params.api
    const node = params.node
    const dataItem = params.data
    const field = params.colDef.field
    const oldValue = params.oldValue
    const newValue = params.newValue
    const onRestore = function (MESSAGE) {
      dataItem[field] = oldValue;
      grid.stopEditing();
      grid.redrawRows();
      if (MESSAGE) { toast.warning({ title: MESSAGE, duration: 5000 }); }
    }

    const excludedFields = [''] // 제외할 필드 목록
    // 모든 필드에 대해 trim 적용
    if (dataItem) {
      Object.keys(dataItem).forEach(key => {
        if (DU.isString(dataItem[key]) && !excludedFields.includes(key)) {
          dataItem[key] = dataItem[key].trim()
        }
      })
    }

    if (field === 'TYPE_ID') {
      // Check Duplicate
      let isDuplicate = false
      const compareVal = String(newValue ?? '').trim().toUpperCase();
      grid.forEachNode(n => {
        if (n.data && n.id !== node.id) {
          const baseVal = String(n.data[field] ?? '').trim().toUpperCase();
          if (baseVal === compareVal) { isDuplicate = true; }
        }
      })
      if (isDuplicate) {
        return onRestore(`This is the use of duplicate names.`)
      }

      dataItem.NEW_TAG_YN = regDictRef.value?.[newValue]?.NEW_TAG_YN === true

      // Use Code Values Area Update
      const focusData = focusDataRef.value
      if (focusData?._ROW_ID === dataItem._ROW_ID) {
        focusDataRef.value = { ...dataItem }
      }
    }

    isEditedRef.value = true
    // if (!params.source) { return; } // 코드에 의한 변경은 처리하지 않음
    dataItem._STATUS = dataItem._STATUS || 'M'
    // node.setSelected(true)
    onRefreshCells({
      force: true,
      suppressFlash: true,
      rowNodes: [node],
      // columns: ['EP_ID', 'DESC', 'CL_ID', 'NEW_TAG_YN'],
    })
  }

  // Keydown 단축키 Ctrl + S 저장 단축키
  const onKeyDown = event => {
    if (event.ctrlKey && event.key === 's') {
      event.preventDefault() //브라우저 기본 저장 동작 방지
      _Emits('on-main-save-data')
    }
  }

  const gridBindRef = ref({
    columnDefs: gridColDefsRef,
    rowData: gridDataRef,
    class: `ag-theme-custom w-100 h-100`,
    rowSelection: 'multiple',
    isRowSelectable: params => {
      return mainOrgFocusDataRef.value?.PROJ_NO === currentProjNo.value
    },
    rowDragManaged: true,
    enableFillHandle: true,
    enableRangeSelection: true,
    suppressRowClickSelection: true,
    rowMultiSelectWithClick: true,
    suppressLastEmptyLineOnPaste: true,
    columnHoverHighlight: true,
    tooltipShowDelay: 0,
    undoRedoCellEditing: true,
    undoRedoCellEditingLimit: 20,
    pagination: false,
    paginationPageSize: 100,
    paginationPageSizeSelector: [100, 500, 1000],
    context: gridContextRef,
    loadingOverlayComponent: AggridLoadingOverlay,
    loadingOverlayComponentParams: {
      loadingMessage: 'Loading...',
    },
    statusBar: {
      statusPanels: [
        { statusPanel: 'agTotalRowCountComponent' },
        { statusPanel: 'agFilteredRowCountComponent' },
        { statusPanel: 'agSelectedRowCountComponent' },
        {
          statusPanel: 'AgDetailStatusBar',
          statusPanelParams: { customStyle: { 'background-color': '#e4dbe9' } },
          align: 'left',
        },
      ],
    },
    defaultColDef: {
      // wrapHeaderText: true,
      // autoHeaderHeight: true,
      editable: params => false,
      cellClass: makeCellClass,
      headerTooltip: params => params.colDef.field,
      tooltipComponent: class {
        elem = document.createElement('div')
        init(params) {
          let value = params.value
          if (params.location === 'header' && DU.isFunction(value)) {
            value = value(params)
          }
          this.elem.className = DU.isNullOrEmpty(value) ? '' : 'ag-tooltip'
          this.elem.innerHTML = value ?? ''
        }
        getGui() {
          return this.elem
        }
      },
      floatingFilter: true,
      filter: 'agMultiColumnFilter',
      filterParams: {
        filters: [
          {
            filter: 'agTextColumnFilter',
            filterParams: { buttons: ['reset'] },
          },
          {
            filter: 'agSetColumnFilter',
            filterParams: {
              buttons: ['reset'],
              valueFormatter: params => params.value,
              comparator: (a, b) => {
                const valA = parseInt(a)
                const valB = parseInt(b)
                if (valA === valB) return 0
                return valA > valB ? 1 : -1
              },
            },
          },
          {
            filter: 'AgCustomFilter',
            filterParams: { buttons: ['reset'] },
          },
        ],
      },
      filterValueGetter: params => String(params.data[params.colDef.field] ?? ''),
    },
    getRowId: onGetRowId,
  })

  const gridEvents = {
    firstDataRendered: onFirstDataRendered,
    cellValueChanged: onCellValueChanged,
    rowSelected: onRowSelected,
    cellFocused: onCellFocused,
    rowDragEnd: onRowDragEnd,
    gridReady: onGridReady,
    keydown: onKeyDown,
  }

  defineOptions({
    name: 'ComplexRegisterLinkedRegister',
    components: { AgDetailStatusBar, AgCustomFilter, AgComboEditor },
  })
  defineExpose({
    FOCUS_DATA: focusDataRef,
    ORG_FOCUS_DATA: focusDataOrgRef,
    DATA_LIST: gridDataRef,
    FOCUS_REG_DATA: focusRegDataRef,
    IS_MANAGER_DATA: isManagerDataRef,
    // Tab으로 사용시 action영역 설정
    CONTENTS_ACTION: contentsActionRef,
    CONTENTS_ACTION_PROPS: contentsActionPropsRef,
    CONTENTS_ACTION_EVENTS: contentsActionEventsRef,
  })
</script>

